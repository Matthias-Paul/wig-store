# Server (Passenger/cPanel sets PORT automatically)
PORT=4000
INTERNAL_API_PORT=4000

# Database (Neon or other external Postgres)
DATABASE_URL=

# Auth
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Cookie policy — use lax + secure with same-origin Next proxy (recommended for iOS).
# Only use none if FE and API are on different sites (and expect iOS cookie issues).
COOKIE_SAME_SITE=lax
COOKIE_SECURE=true
# Leave COOKIE_DOMAIN unset when using Next /api/v1 proxy (host-only on the site domain).
# COOKIE_DOMAIN=.rockshairmpire.com

# Frontend origin for CORS + emails
FRONTEND_URL=https://www.rockshairmpire.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Brevo email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
ADMIN_NOTIFICATION_EMAIL=
